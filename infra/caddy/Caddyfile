# Canonical Caddyfile — story F-3 (Bring up Caddy with staging Let's Encrypt → swap to prod).
#
# Source of truth: xynes/xynes-infra/infra/release/CADDY.md §3.
# If the Caddyfile body below ever drifts from CADDY.md §3, CADDY.md wins —
# update this file from CADDY.md, not the other way around.
#
# Operational notes:
#   - On VPS this file lives at /srv/xynes/caddy/Caddyfile (mounted into the
#     container at /etc/caddy/Caddyfile).
#   - For first-boot staging certs, use the sibling Caddyfile.staging instead;
#     swap back to this one once cert issuance is proven (see README.md §"Rollout
#     sequence").
#   - The QA basic-auth bcrypt placeholder MUST be replaced by the operator
#     before the file is moved into /srv/xynes/caddy/. See README.md §"Generate
#     the QA basic-auth bcrypt hash".

{
    email security@xynes.com
    admin localhost:2019       # admin API not exposed beyond loopback
    # Use Let's Encrypt production by default.
    # Switch to acme_ca https://acme-staging-v02.api.letsencrypt.org/directory while testing.
}

# ====================================================
# Global snippets (security headers, rate limit, etc.)
# ====================================================

(security_headers_prod) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), camera=(), microphone=(), payment=()"
        # CSP intentionally permissive at MVP — tighten per-app in a follow-up.
        Content-Security-Policy   "default-src 'self' https: data:; img-src 'self' https: data:; script-src 'self' https: 'unsafe-inline' 'unsafe-eval'; style-src 'self' https: 'unsafe-inline'; connect-src 'self' https: wss:; frame-ancestors 'none'"
        # Remove server identity
        -Server
    }
}

(security_headers_nonprod) {
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy        "strict-origin-when-cross-origin"
        -Server
        # HSTS deliberately OFF in Dev/QA to avoid sticky-cert lockouts.
    }
}

(common_proxy_opts) {
    transport http {
        dial_timeout 5s
        response_header_timeout 30s
        read_timeout 60s
        write_timeout 60s
    }
}

(deny_admin_paths) {
    @admin path /admin* /internal/* /metrics /.well-known/security.txt
    handle @admin {
        respond 404
    }
}

# ====================================================
# Prod (xynes.com)
# Prod hostnames live under `*.erp.xynes.com` (F-1 ERP namespace
# consolidation, 2026-06-05). The apex `xynes.com` itself is served by a
# separate legacy VPS and is intentionally NOT routed through this Caddy.
# ====================================================

api.erp.xynes.com {
    import security_headers_prod
    import deny_admin_paths

    @health path /health
    handle @health {
        reverse_proxy gateway_prod:4100 {
            import common_proxy_opts
        }
    }

    reverse_proxy gateway_prod:4100 {
        import common_proxy_opts
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
    }

    log {
        output file /var/log/caddy/prod-api.access.log {
            roll_size 100mb
            roll_keep 14
        }
        format json
    }
}

auth.erp.xynes.com {
    import security_headers_prod
    reverse_proxy auth_app_prod:3100 {
        import common_proxy_opts
    }
}

cms.erp.xynes.com {
    import security_headers_prod
    reverse_proxy cms_console_web_prod:3000 {
        import common_proxy_opts
    }
}

# ====================================================
# QA (xynes.com)
# ====================================================

qa-api.erp.xynes.com {
    import security_headers_nonprod
    import deny_admin_paths
    basicauth /* {
        # Optional gate to keep crawlers / unauthorised testers out of QA.
        # Hash generated by: caddy hash-password --algorithm bcrypt
        qa $2a$14$EXAMPLEHASHREPLACEME
    }
    reverse_proxy gateway_qa:4100 {
        import common_proxy_opts
    }
}

qa-auth.erp.xynes.com {
    import security_headers_nonprod
    reverse_proxy auth_app_qa:3100 {
        import common_proxy_opts
    }
}

qa-cms.erp.xynes.com {
    import security_headers_nonprod
    reverse_proxy cms_console_web_qa:3000 {
        import common_proxy_opts
    }
}

# ====================================================
# Dev (xynes.com)
# ====================================================

dev-api.erp.xynes.com {
    import security_headers_nonprod
    import deny_admin_paths
    reverse_proxy gateway_dev:4100 {
        import common_proxy_opts
    }
}

dev-auth.erp.xynes.com {
    import security_headers_nonprod
    reverse_proxy auth_app_dev:3100 {
        import common_proxy_opts
    }
}

dev-cms.erp.xynes.com {
    import security_headers_nonprod
    reverse_proxy cms_console_web_dev:3000 {
        import common_proxy_opts
    }
}

# ====================================================
# Status (Uptime Kuma)
# ====================================================

status.erp.xynes.com {
    import security_headers_prod
    reverse_proxy uptime_kuma:3001 {
        import common_proxy_opts
    }
}

# ====================================================
# xynes.in short-link redirect — ENUMERATED (F-1-FU-1, 2026-06-12)
#
# Original intent (F-1, 2026-06-05): redirect every `*.erp.xynes.in` host to
# the equivalent `*.erp.xynes.com` host so short-links work on the .in TLD
# without colliding with the Outlook mail zone on the apex `xynes.in`.
#
# Why enumerated instead of wildcard: Let's Encrypt issues wildcard certs
# ONLY via the DNS-01 challenge. Caddy's default `tls` configuration uses
# HTTP-01 + TLS-ALPN-01 only, neither of which can satisfy a `*.erp.xynes.in`
# cert request. During the F-3 live VPS bring-up on 2026-06-11 the wildcard
# form caused Caddy to retry-loop the cert request every 2 minutes and burn
# Let's Encrypt rate-limit budget (5 duplicate certs / week / domain).
#
# F-1-FU-1 (2026-06-12) picked **Option A: enumerate the 10 hosts** from the
# three options documented in the now-archived
# `docs/plans/2026-05-13-mvp-release-stories/archive/group-F-caddy-dns-benchmark.md`
# §F-1-FU-1. Each host gets a 10-host comma-separated site block that LE can
# satisfy via HTTP-01. Adding a future ERP host (e.g. `metrics.erp.xynes.com`)
# means appending the matching `metrics.erp.xynes.in` to the site-block list
# below — the literal-wildcard property is lost but no human ever types
# random `.erp.xynes.in` hostnames so the loss is decorative.
#
# Bare `*.xynes.in` is intentionally NOT claimed (the Outlook mail zone on
# the apex `xynes.in` is owned by the operator's mail provider and untouched).
#
# Placeholder used: `{labels.3}` — Caddy v2 indexes labels right-to-left
# (TLD-first), so for `api.erp.xynes.in`: labels.0=`in`, labels.1=`xynes`,
# labels.2=`erp`, labels.3=`api`. The redirect rewrites to
# `https://{labels.3}.erp.xynes.com{uri}` and works uniformly across all 10
# hosts including hyphenated names like `qa-api` and `dev-cms`.
# ====================================================

api.erp.xynes.in, auth.erp.xynes.in, cms.erp.xynes.in, qa-api.erp.xynes.in, qa-auth.erp.xynes.in, qa-cms.erp.xynes.in, dev-api.erp.xynes.in, dev-auth.erp.xynes.in, dev-cms.erp.xynes.in, status.erp.xynes.in {
    redir https://{labels.3}.erp.xynes.com{uri} permanent
}
