# =============================================================================
# .env.prod.template — VPS Prod environment placeholder template
# =============================================================================
#
# This file is the COMMITTED TEMPLATE for the runtime env that the VPS Prod
# stack loads. The filled, real version lives ONLY on the VPS at:
#
#   /srv/xynes/prod/env/.env.prod   (mode 0640, owner root:xynes, NEVER in git)
#
# 🔴 PRODUCTION — every value below must be DISTINCT from Dev and QA.
#    Never reuse a Dev or QA secret in Prod.
#    Rotation cadences live in ../SECRETS.md §"Rotation policy".
#
# Architecture: ../ENVIRONMENTS.md §"Filesystem layout on the VPS"
# Secrets register + rotation policy: ../SECRETS.md
# Incident response (secret leak): ../INCIDENT-RUNBOOK.md §"Secret rotation drill"
#
# Provision steps:
#   1. SCP this template to the VPS: `/srv/xynes/prod/env/.env.prod`
#   2. Fill every `replace-with-...` placeholder (see ../SECRETS.md
#      §"Secret generation recipes")
#   3. `chown root:xynes /srv/xynes/prod/env/.env.prod`
#   4. `chmod 0640 /srv/xynes/prod/env/.env.prod`
#   5. Verify file mode + ownership: `stat -c '%a %U:%G' /srv/xynes/prod/env/.env.prod`
#   6. `docker compose --env-file /srv/xynes/prod/env/.env.prod ... up -d`
#
# Security gate: scripts/test/env-templates-no-secrets.test.sh sweeps this
# file for real-secret patterns on every CI run. If a real Prod secret ever
# appears here, treat it as a P0 leak — rotate via INCIDENT-RUNBOOK.md.
# =============================================================================


# -----------------------------------------------------------------------------
# Image tag pointer (Prod = pinned semver, e.g. `v0.1.0`)
# -----------------------------------------------------------------------------
XYNES_IMAGE_TAG=replace-with-pinned-semver-tag


# -----------------------------------------------------------------------------
# Internal service URLs (Docker DNS inside `xynes_prod_net`)
# -----------------------------------------------------------------------------
GATEWAY_URL=http://gateway:4100
ACCOUNTS_SERVICE_URL=http://accounts-service:4203
AUTHZ_SERVICE_URL=http://authz-service:4300
CMS_CORE_URL=http://cms-core:4202
DOC_SERVICE_URL=http://doc-service:4201
TELEMETRY_SERVICE_URL=http://telemetry-service:4400
STORAGE_SERVICE_URL=http://storage-service:4204


# -----------------------------------------------------------------------------
# Database (per-env Supabase stack — 180-day rotation cadence)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=replace-with-supabase-postgres-password-DISTINCT-FROM-DEV-QA
DATABASE_URL=postgres://postgres:REPLACE@supabase-db:5432/postgres
ACCOUNTS_DATABASE_URL=postgres://postgres:REPLACE@supabase-db:5432/postgres


# -----------------------------------------------------------------------------
# Supabase (180-day rotation as a SET: JWT_SECRET + ANON_KEY + SERVICE_ROLE_KEY)
# -----------------------------------------------------------------------------
SUPABASE_URL=http://supabase-rest:3000
SUPABASE_ANON_KEY=replace-with-prod-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-prod-supabase-service-role-key
JWT_SECRET=replace-with-prod-supabase-jwt-secret
JWT_AUDIENCE=authenticated
# Exact external Supabase Auth issuer claim; replace this inert placeholder.
JWT_ISSUER=https://replace-with-prod-supabase-auth-host.invalid/auth/v1
JWT_MAX_TOKEN_LIFETIME_SECONDS=3600


# -----------------------------------------------------------------------------
# Internal service auth (distinct Ed25519 request identities; see identity runbook)
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Telemetry privacy (365-day rotation)
# -----------------------------------------------------------------------------
TELEMETRY_IP_HASH_SALT=replace-with-openssl-rand-hex-32


# -----------------------------------------------------------------------------
# Feature flags (Prod PostHog project — distinct from Dev/QA)
# -----------------------------------------------------------------------------
POSTHOG_API_KEY=replace-with-posthog-project-api-key-prod
POSTHOG_HOST=https://eu.posthog.com
# Prod: keep flag debug logs off to avoid noisy telemetry.
FEATURE_FLAGS_DEBUG=false


# -----------------------------------------------------------------------------
# Frontend public env (NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL=https://api.erp.xynes.com
NEXT_PUBLIC_AUTH_APP_URL=https://auth.erp.xynes.com
NEXT_PUBLIC_CMS_APP_URL=https://cms.erp.xynes.com


# -----------------------------------------------------------------------------
# CORS allowlist (gap A3 — Prod hosts only, no wildcards, exact match)
# -----------------------------------------------------------------------------
GATEWAY_CORS_ALLOWED_ORIGINS=https://auth.erp.xynes.com,https://cms.erp.xynes.com


# -----------------------------------------------------------------------------
# Cross-app session contract (gap A4)
# ERP namespace consolidation (F-1, 2026-06-05): cookie domain narrows from
# `xynes.com` to `.erp.xynes.com`. See `.env.dev.template` for the rationale.
# -----------------------------------------------------------------------------
AUTH_COOKIE_DOMAIN=.erp.xynes.com
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=true


# -----------------------------------------------------------------------------
# Universal Object Storage (Prod bucket — DISTINCT from Dev + QA)
# -----------------------------------------------------------------------------
STORAGE_PROCESSOR_MODE=live
CLAMD_HOST=clamav-clamd
CLAMD_PORT=3310

R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=xynes-storage-prod
R2_REGION=auto
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_PROD_ACCESS_KEY_ID=replace-with-cloudflare-r2-prod-access-key-id
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_PROD_SECRET_ACCESS_KEY=replace-with-cloudflare-r2-prod-secret-access-key


# -----------------------------------------------------------------------------
# Mailer (Prod Resend API key — DISTINCT from Dev + QA; verified sender domain)
# -----------------------------------------------------------------------------
MAIL_PROVIDER=resend
MAIL_RESEND_SECRET_REF=secret://xynes/mail/resend-prod
MAIL_CREDENTIAL_XYNES__MAIL__RESEND_PROD_API_KEY=replace-with-resend-api-key
MAIL_CREDENTIAL_XYNES__MAIL__RESEND_PROD_FROM_ADDRESS=no-reply@xynes.com
INVITE_BASE_URL=https://auth.erp.xynes.com


# -----------------------------------------------------------------------------
# Google OAuth (gap A2 — closes 2026-06-04; see AUTH-PROVIDERS.md)
# Per-env Google Cloud project: xynes-prod (DISTINCT from Dev + QA — Prod isolation)
# -----------------------------------------------------------------------------
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOTRUE_EXTERNAL_GOOGLE_SECRET=replace-with-google-oauth-client-secret
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://supabase.erp.xynes.com/auth/v1/callback


# -----------------------------------------------------------------------------
# Backups (Backblaze B2 — Prod-only secrets, 365-day rotation)
# -----------------------------------------------------------------------------
B2_KEY_ID=replace-with-backblaze-b2-application-key-id
B2_APPLICATION_KEY=replace-with-backblaze-b2-application-key
AGE_BACKUP_RECIPIENT=replace-with-age-public-recipient-string


# -----------------------------------------------------------------------------
# Operational hardening
# -----------------------------------------------------------------------------
# Caddy admin API token (local Docker network only; not exposed publicly).
CADDY_ADMIN_TOKEN=replace-with-openssl-rand-hex-32

# SEC-003 request-bound identities. Never put private PEM values in shared env.
# Compose mounts individual keys; host services use their own file paths.
XYNES_INTERNAL_IDENTITIES_DIR=./.internal-identities
GATEWAY_INTERNAL_REQUEST_KEY_ID=g1
ACCOUNTS_INTERNAL_REQUEST_KEY_ID=a1
# INTERNAL_REQUEST_PRIVATE_KEY_FILE and INTERNAL_REQUEST_KEY_ID are service-specific.
# Each receiver gets its own public INTERNAL_REQUEST_TRUST_FILE; only gateway has no receiver trust mount.
# See infra/release/INTERNAL-REQUEST-IDENTITIES.md for provisioning/rotation.

# Remaining owner identities (private paths are injected per service by Compose).
CMS_INTERNAL_REQUEST_KEY_ID=c1
DOCS_INTERNAL_REQUEST_KEY_ID=d1
STORAGE_INTERNAL_REQUEST_KEY_ID=s1
TELEMETRY_INTERNAL_REQUEST_KEY_ID=t1
