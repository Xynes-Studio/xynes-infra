# =============================================================================
# .env.staging.template — VPS STAGING environment placeholder template
# =============================================================================
#
# This file is the COMMITTED TEMPLATE for the runtime env that the VPS STAGING
# stack loads. The filled, real version lives ONLY on the VPS at:
#
#   /srv/xynes/staging/env/.env.staging   (mode 0640, owner root:xynes, NEVER in git)
#
# Staging validates accepted QA releases before promotion to Prod. Secrets MUST be
# distinct from Dev, QA and Prod — never reuse a value across environments.
#
# Architecture: ../ENVIRONMENTS.md §"Filesystem layout on the VPS"
# Secrets register + rotation policy: ../SECRETS.md
#
# Provision steps:
#   1. SCP this template to the VPS: `/srv/xynes/staging/env/.env.staging`
#   2. Fill every `replace-with-...` placeholder (see ../SECRETS.md
#      §"Secret generation recipes")
#   3. `chown root:xynes /srv/xynes/staging/env/.env.staging`
#   4. `chmod 0640 /srv/xynes/staging/env/.env.staging`
#   5. `docker compose --env-file /srv/xynes/staging/env/.env.staging ... up -d`
#
# Security gate: scripts/test/env-templates-no-secrets.test.sh sweeps this
# file for real-secret patterns on every CI run.
# =============================================================================


# -----------------------------------------------------------------------------
# Image tag pointer (STAGING = explicit version, e.g. `v0.1.0-rc.1`)
# -----------------------------------------------------------------------------
XYNES_IMAGE_TAG=replace-with-rc-tag


# -----------------------------------------------------------------------------
# Internal service URLs (Docker DNS inside `xynes_staging_net`)
# -----------------------------------------------------------------------------
GATEWAY_URL=http://gateway:4100
ACCOUNTS_SERVICE_URL=http://accounts-service:4203
AUTHZ_SERVICE_URL=http://authz-service:4300
CMS_CORE_URL=http://cms-core:4202
DOC_SERVICE_URL=http://doc-service:4201
TELEMETRY_SERVICE_URL=http://telemetry-service:4400
STORAGE_SERVICE_URL=http://storage-service:4204


# -----------------------------------------------------------------------------
# Database (per-env Supabase stack)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=replace-with-supabase-postgres-password-DISTINCT-FROM-DEV-QA-PROD
DATABASE_URL=postgres://postgres:REPLACE@supabase-db:5432/postgres
ACCOUNTS_DATABASE_URL=postgres://postgres:REPLACE@supabase-db:5432/postgres


# -----------------------------------------------------------------------------
# Supabase (DISTINCT keys from Dev + QA + Prod)
# -----------------------------------------------------------------------------
SUPABASE_URL=http://replace-with-staging-supabase-internal-host.invalid
SUPABASE_ANON_KEY=replace-with-staging-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-supabase-service-role-key
JWT_SECRET=replace-with-staging-supabase-jwt-secret
JWT_AUDIENCE=authenticated
# Exact external Supabase Auth issuer claim; replace this inert placeholder.
JWT_ISSUER=https://replace-with-staging-supabase-auth-host.invalid/auth/v1
JWT_MAX_TOKEN_LIFETIME_SECONDS=3600


# -----------------------------------------------------------------------------
# Internal service auth (DISTINCT secrets from Dev + QA + Prod)
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Telemetry privacy (DISTINCT salt from Dev + QA + Prod)
# -----------------------------------------------------------------------------
TELEMETRY_IP_HASH_SALT=replace-with-openssl-rand-hex-32


# -----------------------------------------------------------------------------
# Feature flags (separate PostHog project for STAGING strongly recommended)
# -----------------------------------------------------------------------------
POSTHOG_API_KEY=replace-with-posthog-project-api-key-staging
POSTHOG_HOST=https://eu.posthog.com
FEATURE_FLAGS_DEBUG=false


# -----------------------------------------------------------------------------
# Frontend public env
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL=https://api.staging.xynes.com
NEXT_PUBLIC_AUTH_APP_URL=https://auth.staging.xynes.com
NEXT_PUBLIC_CMS_APP_URL=https://cms.staging.xynes.com


# -----------------------------------------------------------------------------
# CORS allowlist (gap A3)
# -----------------------------------------------------------------------------
GATEWAY_CORS_ALLOWED_ORIGINS=https://auth.staging.xynes.com,https://cms.staging.xynes.com


# -----------------------------------------------------------------------------
# Cross-app session contract (gap A4)
# ERP namespace consolidation (F-1, 2026-06-05): cookie domain narrows from
# The staging cookie domain must be confined to its own frontend namespace.
# Configure actual staging hosts and cookie isolation before deployment.
# -----------------------------------------------------------------------------
AUTH_COOKIE_DOMAIN=.staging.xynes.com
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=true


# -----------------------------------------------------------------------------
# Universal Object Storage (DISTINCT bucket from Dev + QA + Prod)
# -----------------------------------------------------------------------------
STORAGE_PROCESSOR_MODE=live
CLAMD_HOST=clamav-clamd
CLAMD_PORT=3310

R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=xynes-storage-staging
R2_REGION=auto
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_STAGING_ACCESS_KEY_ID=replace-with-cloudflare-r2-staging-access-key-id
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_STAGING_SECRET_ACCESS_KEY=replace-with-cloudflare-r2-staging-secret-access-key


# -----------------------------------------------------------------------------
# Mailer (DISTINCT Resend API key from Dev + QA + Prod recommended)
# -----------------------------------------------------------------------------
MAIL_PROVIDER=resend
MAIL_RESEND_SECRET_REF=secret://xynes/mail/resend-staging
MAIL_CREDENTIAL_XYNES__MAIL__RESEND_STAGING_API_KEY=replace-with-resend-api-key
MAIL_CREDENTIAL_XYNES__MAIL__RESEND_STAGING_FROM_ADDRESS=no-reply@staging.xynes.com
INVITE_BASE_URL=https://auth.staging.xynes.com

# -----------------------------------------------------------------------------
# Google OAuth (gap A2 — closes 2026-06-04; see AUTH-PROVIDERS.md)
# Use a staging-specific OAuth client/redirect; an existing Cloud project can host it.
# -----------------------------------------------------------------------------
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOTRUE_EXTERNAL_GOOGLE_SECRET=replace-with-google-oauth-client-secret
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://supabase.staging.xynes.com/auth/v1/callback

# SEC-003 request-bound identities. Never put private PEM values in shared env.
# Compose mounts individual keys; host services use their own file paths.
XYNES_INTERNAL_IDENTITIES_DIR=./.internal-identities
GATEWAY_INTERNAL_REQUEST_KEY_ID=g1
ACCOUNTS_INTERNAL_REQUEST_KEY_ID=a1
# INTERNAL_REQUEST_PRIVATE_KEY_FILE and INTERNAL_REQUEST_KEY_ID are service-specific.
# Each receiver gets its own public INTERNAL_REQUEST_TRUST_FILE; only gateway has no receiver trust mount.
# See infra/release/INTERNAL-REQUEST-IDENTITIES.md for provisioning/rotation.

# Remaining owner identities (private paths are injected per service by Compose).
CMS_INTERNAL_REQUEST_KEY_ID=c1
DOCS_INTERNAL_REQUEST_KEY_ID=d1
STORAGE_INTERNAL_REQUEST_KEY_ID=s1
TELEMETRY_INTERNAL_REQUEST_KEY_ID=t1
