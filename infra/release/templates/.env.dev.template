# =============================================================================
# .env.dev.template — VPS Dev environment placeholder template
# =============================================================================
#
# This file is the COMMITTED TEMPLATE for the runtime env that the VPS Dev
# stack loads. The filled, real version lives ONLY on the VPS at:
#
#   /srv/xynes/dev/env/.env.dev   (mode 0640, owner root:xynes, NEVER in git)
#
# Architecture: ../ENVIRONMENTS.md §"Filesystem layout on the VPS"
# Secrets register + rotation policy: ../SECRETS.md
# Local-dev counterpart: ../../.env.example (single file, both modes)
#
# Provision steps:
#   1. SCP this template to the VPS: `/srv/xynes/dev/env/.env.dev`
#   2. Fill every `replace-with-...` placeholder (see ../SECRETS.md
#      §"Secret generation recipes" for the openssl/age/Supabase commands)
#   3. `chown root:xynes /srv/xynes/dev/env/.env.dev`
#   4. `chmod 0640 /srv/xynes/dev/env/.env.dev`
#   5. `docker compose --env-file /srv/xynes/dev/env/.env.dev ... up -d`
#
# Security gate: scripts/test/env-templates-no-secrets.test.sh sweeps this
# file for real-secret patterns (AKIA*, xynes_live_*, re_*, JWTs, etc.) on
# every CI run. Real values committed here MUST be rotated immediately.
# =============================================================================


# -----------------------------------------------------------------------------
# Image tag pointer (Dev = `dev-latest` rolling tag)
# -----------------------------------------------------------------------------
XYNES_IMAGE_TAG=dev-latest


# -----------------------------------------------------------------------------
# Internal service URLs (Docker DNS inside `xynes_dev_net`)
# -----------------------------------------------------------------------------
GATEWAY_URL=http://gateway:4100
ACCOUNTS_SERVICE_URL=http://accounts-service:4203
AUTHZ_SERVICE_URL=http://authz-service:4300
CMS_CORE_URL=http://cms-core:4202
DOC_SERVICE_URL=http://doc-service:4201
TELEMETRY_SERVICE_URL=http://telemetry-service:4400
STORAGE_SERVICE_URL=http://storage-service:4204


# -----------------------------------------------------------------------------
# Database (per-env Supabase stack)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=replace-with-supabase-postgres-password
DATABASE_URL=postgres://postgres:REPLACE@supabase-db:5432/postgres
ACCOUNTS_DATABASE_URL=postgres://postgres:REPLACE@supabase-db:5432/postgres


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=http://supabase-rest:3000
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
JWT_SECRET=replace-with-supabase-jwt-secret
JWT_AUDIENCE=authenticated
# Exact external Supabase Auth issuer claim; replace this inert placeholder.
JWT_ISSUER=https://replace-with-dev-supabase-auth-host.invalid/auth/v1
JWT_MAX_TOKEN_LIFETIME_SECONDS=3600


# -----------------------------------------------------------------------------
# Bound internal service identities (SEC-003-FU-1)
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Telemetry privacy
# -----------------------------------------------------------------------------
TELEMETRY_IP_HASH_SALT=replace-with-openssl-rand-hex-32


# -----------------------------------------------------------------------------
# Feature flags (INFRA-BE-1 — PostHog server-side, EU region)
# -----------------------------------------------------------------------------
POSTHOG_API_KEY=replace-with-posthog-project-api-key-dev
POSTHOG_HOST=https://eu.posthog.com
FEATURE_FLAGS_DEBUG=false


# -----------------------------------------------------------------------------
# Frontend public env (NEXT_PUBLIC_* — NOT secrets, kept here for env hygiene)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL=https://dev-api.erp.xynes.com
NEXT_PUBLIC_AUTH_APP_URL=https://dev-auth.erp.xynes.com
NEXT_PUBLIC_CMS_APP_URL=https://dev-cms.erp.xynes.com


# -----------------------------------------------------------------------------
# CORS allowlist (gap A3)
# -----------------------------------------------------------------------------
GATEWAY_CORS_ALLOWED_ORIGINS=https://dev-auth.erp.xynes.com,https://dev-cms.erp.xynes.com


# -----------------------------------------------------------------------------
# Cross-app session contract (gap A4)
# ERP namespace consolidation (F-1, 2026-06-05): cookie domain narrows from
# `xynes.com` to `.erp.xynes.com` so legacy-site auth and ERP auth stay isolated.
# `auth.erp.xynes.com` sets a cookie that `cms.erp.xynes.com` can read, but the
# legacy `xynes.com` apex (separate VPS) cannot.
# -----------------------------------------------------------------------------
AUTH_COOKIE_DOMAIN=.erp.xynes.com
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=true


# -----------------------------------------------------------------------------
# Universal Object Storage (STORAGE-LIVE-1)
# Production reads `STORAGE_CREDENTIAL_*` via a real SecretManagerClient
# (see ../SECRETS.md §"Hosted secrets resolution path"). The env-backed local
# resolver path below is the local-dev convention only — on the VPS, prefer
# the secret-manager URI form by wiring the production SecretManagerClient
# in the storage-service composition root.
# -----------------------------------------------------------------------------
STORAGE_PROCESSOR_MODE=stub
CLAMD_HOST=clamav-clamd
CLAMD_PORT=3310

R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=xynes-storage-dev
R2_REGION=auto
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_ACCESS_KEY_ID=replace-with-cloudflare-r2-access-key-id
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_SECRET_ACCESS_KEY=replace-with-cloudflare-r2-secret-access-key


# -----------------------------------------------------------------------------
# Mailer (MAIL-4 / MAIL-5 — Resend in hosted environments)
# -----------------------------------------------------------------------------
MAIL_PROVIDER=resend
MAIL_RESEND_SECRET_REF=secret://xynes/mail/resend-dev
MAIL_CREDENTIAL_XYNES__MAIL__RESEND_DEV_API_KEY=replace-with-resend-api-key
MAIL_CREDENTIAL_XYNES__MAIL__RESEND_DEV_FROM_ADDRESS=no-reply@dev.xynes.com
INVITE_BASE_URL=https://dev-auth.erp.xynes.com

# -----------------------------------------------------------------------------
# Google OAuth (gap A2 — closes 2026-06-04; see AUTH-PROVIDERS.md)
# Per-env Google Cloud project: xynes-dev
# -----------------------------------------------------------------------------
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOTRUE_EXTERNAL_GOOGLE_SECRET=replace-with-google-oauth-client-secret
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://dev-auth.erp.xynes.com/callback

# SEC-003 request-bound identities. Never put private PEM values in shared env.
# Compose mounts individual keys; host services use their own file paths.
XYNES_INTERNAL_IDENTITIES_DIR=./.internal-identities
GATEWAY_INTERNAL_REQUEST_KEY_ID=g1
ACCOUNTS_INTERNAL_REQUEST_KEY_ID=a1
# INTERNAL_REQUEST_PRIVATE_KEY_FILE and INTERNAL_REQUEST_KEY_ID are service-specific.
# Each receiver gets its own public INTERNAL_REQUEST_TRUST_FILE; only gateway has no receiver trust mount.
# See infra/release/INTERNAL-REQUEST-IDENTITIES.md for provisioning/rotation.

# Remaining owner identities (private paths are injected per service by Compose).
CMS_INTERNAL_REQUEST_KEY_ID=c1
DOCS_INTERNAL_REQUEST_KEY_ID=d1
STORAGE_INTERNAL_REQUEST_KEY_ID=s1
TELEMETRY_INTERNAL_REQUEST_KEY_ID=t1
