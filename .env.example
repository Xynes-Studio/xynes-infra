# =============================================================================
# xynes-infra — example env for the Docker dev stack
# =============================================================================
#
# Copy this file to one of:
#   .env.dev          — Docker dev stack (local Supabase by default)
#   .env.localhost    — Host-run scripts (bun run dev, bun test, smoke-*.sh)
#
# Both target filenames are git-ignored (see .gitignore: `.env.*` excluded
# with the `!.env.example` exception).
#
# Generate per-line secrets locally — never paste secrets into chat, PR
# comments, or upstream documentation. See:
#   - ENV_GUIDE.md
#   - docs/plans/archive/2026-05-13-storage-provider-env-values-worksheet.md
# =============================================================================

# Local Supabase mode (no SSH tunnel)
#
# Use with:
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up -d --build
#
# This tells docker-compose.dev.yml to load this file into container runtime env too.
# When copying to `.env.dev` (hosted/tunneled Supabase), set to `.env.dev` instead.
XYNES_DOCKER_ENV_FILE=.env.dev

# Prereq for local Supabase mode:
#   - Supabase running locally via `supabase start` in ./supabase
#   - Local Supabase DB exposed on host port 5432 (see supabase/config.toml [db].port)
#
# Containers reach the host via `db.local` (IPv4 host-gateway) pinned in
# docker-compose.dev.yml `extra_hosts`.


# -----------------------------------------------------------------------------
# Shared dev ports (host side)
# -----------------------------------------------------------------------------
GATEWAY_PORT=4100
DOC_SERVICE_PORT=4201
CMS_CORE_PORT=4202
ACCOUNTS_SERVICE_PORT=4203
AUTHZ_SERVICE_PORT=4300
TELEMETRY_SERVICE_PORT=4400
# STORAGE-12: storage-service port. Matches storage-service `src/infra/config.ts`
# DEFAULT_PORT (4204) and the compose container's STORAGE_SERVICE_PORT.
STORAGE_SERVICE_PORT=4204


# -----------------------------------------------------------------------------
# Internal URLs (what the gateway uses inside the docker network)
# -----------------------------------------------------------------------------
DOC_SERVICE_URL=http://doc-service:4201
CMS_CORE_URL=http://cms-core:4202
ACCOUNTS_SERVICE_URL=http://accounts-service:4203
AUTHZ_SERVICE_URL=http://authz-service:4300
TELEMETRY_SERVICE_URL=http://telemetry-service:4400

# STORAGE-12: Universal Object Storage service URL. Gateway proxies
# /workspaces/:workspaceId/storage/* routes to this base URL appended
# with /internal/storage-actions. When unset, storage routes fail
# closed at the gateway with 502 BAD_GATEWAY.
STORAGE_SERVICE_URL=http://storage-service:4204


# -----------------------------------------------------------------------------
# Bound service identities (SEC-003-FU-1)
# -----------------------------------------------------------------------------
# No shared bearer/JWT credentials. Provision .internal-identities once; Compose
# mounts only each service's private key and receiver-specific public trust file.
# See infra/release/INTERNAL-REQUEST-IDENTITIES.md. Host processes must use their
# own INTERNAL_REQUEST_PRIVATE_KEY_FILE / INTERNAL_REQUEST_KEY_ID and public
# INTERNAL_REQUEST_TRUST_FILE rather than sharing signing variables in this file.

# TELE-GW-1: Salt for hashing client IPs in gateway telemetry (privacy protection).
# Generate with: `openssl rand -hex 32`
TELEMETRY_IP_HASH_SALT=replace-with-openssl-rand-hex-32


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# `db.local` is pinned via docker-compose `extra_hosts` to the IPv4 host-gateway
# so containers can reliably reach your SSH tunnel / local Supabase. See
# ENV_GUIDE.md for the recommended values per env mode.
#
# Default local Supabase DB user/pass is often postgres/postgres — confirm via
# `supabase status`.
DATABASE_URL=postgres://postgres:postgres@db.local:5432/postgres

# Accounts service uses a dedicated DB user when available; otherwise point at
# DATABASE_URL.
ACCOUNTS_DATABASE_URL=postgres://postgres:postgres@db.local:5432/postgres


# -----------------------------------------------------------------------------
# Feature flags (INFRA-BE-1)
# -----------------------------------------------------------------------------
# PostHog project API key — server-side `posthog-node` only. The gateway
# evaluates flags via `/flags` and never ships `phc_*` to the browser.
POSTHOG_API_KEY=replace-with-posthog-project-api-key
# Region-pinned host. EU project → `https://eu.posthog.com`.
# US project → `https://us.posthog.com` or `https://app.posthog.com`.
POSTHOG_HOST=https://eu.posthog.com
# When `true`, gateway emits per-evaluation diagnostic logs (subject to
# STORAGE-9 redaction). Leave off in production.
FEATURE_FLAGS_DEBUG=true


# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# JWT secret used by both the gateway and Supabase Auth in local mode.
# For local Supabase, this MUST match the secret in supabase/config.toml,
# otherwise /me returns 401. See ENV_GUIDE.md.
JWT_SECRET=replace-with-local-supabase-jwt-secret
JWT_ISSUER=http://127.0.0.1:54321/auth/v1
JWT_AUDIENCE=authenticated
JWT_MAX_TOKEN_LIFETIME_SECONDS=3600


# =============================================================================
# Universal Object Storage — STORAGE-4 (capture during provisioning)
# =============================================================================
#
# These env values feed `platform.workspace_storage_providers` rows when a
# workspace is provisioned. The schema is the same for every S3-compatible
# provider — only the values differ. See:
#   - docs/plans/archive/2026-05-10-universal-object-storage-file-upload-api.md §3
#   - docs/plans/archive/2026-05-13-storage-provider-env-values-worksheet.md
#
# Security rules:
#   - Never commit a populated copy of this file (`.env.*` is git-ignored).
#   - Raw access keys and secret keys go ONLY in a git-ignored `.env.dev`
#     for local-dev runs. Production / hosted environments wire a real
#     `SecretManagerClient` (AWS Secrets Manager / Doppler / Vault) — the
#     `EnvSecretManagerClient` path is local-dev only.
#   - The storage-service resolves credentials at runtime via the
#     `credential_ref` column on `platform.workspace_storage_providers`.
#     The env-var naming convention below MUST match
#     `xynes-storage-service/src/infra/providers/secret-manager.ts`
#     `secretPathToEnvPrefix(path)` so the resolver can find the values:
#       `secret://xynes/storage/r2-dev` →
#         `STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_ACCESS_KEY_ID`
#         `STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_SECRET_ACCESS_KEY`
#   - Never paste raw keys into chat, PR comments, or commit history. If a key
#     ever appears in any of those, rotate it at the provider immediately.
# =============================================================================


# -----------------------------------------------------------------------------
# Cloudflare R2 — default hosted provider for STORAGE-4 / STORAGE-LIVE-1
# -----------------------------------------------------------------------------
# Provision steps:
#   1. Cloudflare dashboard → R2 → Overview → copy Account ID (32 hex chars).
#   2. R2 → Create bucket → name = R2_BUCKET below.
#   3. R2 → Manage API tokens → Create API token → "Object Read & Write" →
#      scope to the bucket → copy access key id + secret access key ONCE.
#   4. Paste the raw key + secret into your git-ignored `.env.dev`
#      under the STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_* names below.
#      Do NOT paste them into THIS .env.example file (it is committed).
# -----------------------------------------------------------------------------

# 32-char hex Cloudflare Account ID.
R2_ACCOUNT_ID=00000000000000000000000000000000

# Bucket name. Suggested convention: xynes-storage-<env>.
R2_BUCKET=xynes-storage-dev

# R2 region MUST be `auto`. Empty string and `us-east-1` also alias to `auto`.
R2_REGION=auto

# Derived endpoint host — uncomment after R2_ACCOUNT_ID is filled in.
# R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# Optional storage class. R2 supports `STANDARD` and `STANDARD_IA`.
R2_STORAGE_CLASS=STANDARD

# Token credentials — STORAGE-FU-3 EnvSecretManagerClient convention.
# Read by `xynes-storage-service` when a `platform.workspace_storage_providers`
# row points at `credential_ref = 'secret://xynes/storage/r2-dev'`.
# Fill the real values ONLY in a git-ignored `.env.dev`; this template
# uses placeholder strings the resolver will reject as MATERIAL_INVALID.
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_ACCESS_KEY_ID=replace-with-cloudflare-r2-access-key-id
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_SECRET_ACCESS_KEY=replace-with-cloudflare-r2-secret-access-key


# -----------------------------------------------------------------------------
# Backblaze B2 — alternate hosted provider (deferred to STORAGE-LIVE-6)
# -----------------------------------------------------------------------------
# Provision steps:
#   1. Backblaze console → Buckets → Create a Bucket → Private →
#      name = B2_BUCKET below (no underscores; `b2-` prefix reserved).
#   2. App Keys → Add a New Application Key → scope to the bucket →
#      permissions `readWrite + listBuckets + listFiles` → copy ID + key ONCE.
# B2-specific quirks (already baked into STORAGE-4 / 9):
#   - SigV4 only (v2 rejected).
#   - `x-amz-tagging` on PUT/Copy is rejected.
#   - No browser POST form uploads.
#   - CORS XML ≤ 100 KB, MaxAgeSeconds ∈ [0, 86400], non-empty AllowedOrigin.
# -----------------------------------------------------------------------------

# Real region — NOT `auto`. Example: us-east-005, eu-central-003.
B2_REGION=us-east-005

# Bucket name. Suggested convention: xynes-storage-<env>-b2.
B2_BUCKET=xynes-storage-dev-b2

# Derived endpoint host — uncomment after B2_REGION is filled in.
# B2_ENDPOINT=https://s3.${B2_REGION}.backblazeb2.com

# Application Key credentials — STORAGE-FU-3 convention.
# Read by `xynes-storage-service` when `credential_ref = 'secret://xynes/storage/b2-dev'`.
STORAGE_CREDENTIAL_XYNES__STORAGE__B2_DEV_ACCESS_KEY_ID=replace-with-backblaze-b2-application-key-id
STORAGE_CREDENTIAL_XYNES__STORAGE__B2_DEV_SECRET_ACCESS_KEY=replace-with-backblaze-b2-application-key


# -----------------------------------------------------------------------------
# iDrive e2 — alternate hosted provider (deferred indefinitely)
# -----------------------------------------------------------------------------
# Capture only when a workspace adopts e2. Onboarding gate: a region MUST be
# enabled via Dashboard → Regions dropdown → "Enable" BEFORE the "Create Bucket"
# CTA appears in the e2 console. See the worksheet for full provisioning steps.
# -----------------------------------------------------------------------------

# Real region — NOT `auto`. e.g. Frankfurt, Singapore.
# E2_REGION=

# Per-account, per-region endpoint host shown under Dashboard → Enabled regions
# after the region has been enabled. NOT derivable from E2_REGION alone.
# E2_ENDPOINT=

# Bucket name. Suggested convention: xynes-storage-<env>-e2.
# E2_BUCKET=xynes-storage-dev-e2

# Access key credentials (shown once at creation in the e2 Access Keys tab).
# STORAGE_CREDENTIAL_XYNES__STORAGE__E2_DEV_ACCESS_KEY_ID=
# STORAGE_CREDENTIAL_XYNES__STORAGE__E2_DEV_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# Storage processor mode + ClamAV (STORAGE-FU-5 / STORAGE-FU-5-FU-D / FU-E)
# -----------------------------------------------------------------------------
# `stub` (default outside production) runs deterministic in-memory stubs for
# image / video / document processors and a noop malware scanner — keeps
# `bun run dev` runnable on a clean laptop with no extra containers.
#
# `live` wires the real processors:
#   - sharp (in-process, libvips bundled by the npm package)
#   - ffmpeg (in-process via `ffmpeg-static`)
#   - LibreOffice (via the `libreoffice-sidecar` profile)
#   - ClamAV (via the `clamav-clamd` + `clamav-freshclam` sidecars)
#
# Before flipping to `live`, bring the sidecars up with the STORAGE-FU-E
# overlay. See `xynes-storage-service/docs/deployment-posture.md` §9.
STORAGE_PROCESSOR_MODE=stub

# clamd network endpoint. `clamav-clamd` is the sidecar hostname from the
# STORAGE-FU-E compose overlay. The clamav container binds 0.0.0.0:3310
# via `CLAMD_CONF_TCPAddr=0.0.0.0` per FU-E-FIX-1.
CLAMD_HOST=clamav-clamd
CLAMD_PORT=3310

# LibreOffice sidecar HTTP endpoint (FU-G shim). Required when
# STORAGE_PROCESSOR_MODE=live AND the `--profile libreoffice` compose flag
# is set; unset surfaces document_preview as PROCESSOR_FAILED (safe-fail).
# LIBREOFFICE_SERVICE_URL=http://libreoffice-sidecar:8100


# =============================================================================
# Mailer (MAIL-1 / MAIL-2 / MAIL-4 / MAIL-5)
# =============================================================================
#
# Closed-set provider selector (`MAIL_PROVIDER`):
#   `noop`   — default; no mail dispatched; invite rows still land.
#   `stub`   — StubMailerClient. Writes to stdout OR relays via SMTP_RELAY_URL.
#              Use with the local Supabase Inbucket inbox at
#              http://127.0.0.1:54324 (MAIL-1).
#   `resend` — ResendMailerClient (hosted). Reads the API key + sender via
#              MAIL_RESEND_SECRET_REF through the SecretManagerClient.
#
# Security rules (MAIL-4):
#   - Raw `re_*` Resend API keys NEVER appear in this committed template.
#   - Hosted environments wire a real SecretManagerClient
#     (AWS Secrets Manager / Doppler / Vault). The env-backed
#     EnvSecretManagerClient is local-dev only.
#   - Gateway telemetry + snippet redaction already mask `re_[A-Za-z0-9_-]{8,}`
#     and the `resend_api_key` family of field names.
#
# Stub mode against Supabase Inbucket (uncomment the three lines below):
# MAIL_PROVIDER=stub
# SMTP_RELAY_URL=smtp://host.docker.internal:54325
# INVITE_BASE_URL=http://localhost:3100
# =============================================================================

MAIL_PROVIDER=
MAIL_RESEND_SECRET_REF=
MAIL_CREDENTIAL_XYNES__MAIL__RESEND_DEV_API_KEY=
MAIL_CREDENTIAL_XYNES__MAIL__RESEND_DEV_FROM_ADDRESS=
# Base URL the create / resend handlers compose invite links against.
# Default `http://localhost:3100` matches the local auth-app. Strip trailing /.
# INVITE_BASE_URL=http://localhost:3100
# Lifetime resend-attempt cap per invite row. Default 5; beyond the cap,
# `accounts.invites.resend` returns 429 without invoking the mailer.
# MAIL_RESEND_MAX_ATTEMPTS=5


# =============================================================================
# Supabase Auth settings for local development
# =============================================================================
#
# These should align with the settings in supabase/config.toml and the
# JWT_SECRET above. When running against local Supabase, JWT_SECRET MUST
# match supabase/config.toml or /me returns 401.
# =============================================================================

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# Supabase-internal secrets. Generate per-line locally; never commit populated
# values. See `supabase status` for the JWT secret + anon/service role keys
# emitted by `supabase start`.
ANON_KEY=replace-with-supabase-anon-key
SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
POSTGRES_PASSWORD=replace-with-postgres-password
DASHBOARD_USERNAME=replace-with-dashboard-username
DASHBOARD_PASSWORD=replace-with-dashboard-password
SECRET_KEY_BASE=replace-with-openssl-rand-hex-64
VAULT_ENC_KEY=replace-with-openssl-rand-hex-32
PG_META_CRYPTO_KEY=replace-with-openssl-rand-hex-32
POOLER_TENANT_ID=replace-with-pooler-tenant-id

DOCKER_SOCKET_LOCATION=/var/run/docker.sock
POSTGRES_HOST=db.local
POSTGRES_PORT=5432
POSTGRES_DB=postgres
# JWT lifetime in seconds. 3600 = 1h (default in supabase/config.toml).
JWT_EXPIRY=3600
PGRST_DB_SCHEMAS=public,storage,graphql_public

# External Supabase URLs (used by hosted-style deployments). For pure local-dev
# (`supabase start` on localhost), set all three to `http://127.0.0.1:54321`
# and ADDITIONAL_REDIRECT_URLS to your auth-app origin (`http://localhost:3100`).
SITE_URL=http://127.0.0.1:54321
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
API_EXTERNAL_URL=http://127.0.0.1:54321
ADDITIONAL_REDIRECT_URLS=http://localhost:3100

# Logflare tokens (hosted Supabase only; safe to leave blank for local mode).
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=


# =============================================================================
# Supabase Auth (GoTrue) SMTP — for real email delivery
# =============================================================================
#
# GoTrue (Supabase Auth) handles signup-confirm / password-reset / magic-link
# delivery. This is SEPARATE from the workspace-invite mailer above — invites
# go through the accounts-service MailerClient (MAIL-2 / MAIL-4 / MAIL-5).
#
# IMPORTANT:
#   - Do NOT commit real SMTP credentials to git.
#   - For Microsoft 365, prefer an App Password (if MFA is on) and ensure
#     SMTP AUTH is enabled on the sender mailbox.
#   - For local-dev, leave these blank and rely on Inbucket (MAIL-1) — GoTrue
#     falls back to the Inbucket SMTP relay when `[inbucket].enabled = true`
#     in supabase/config.toml.
#
# Microsoft 365 baseline:
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=
GOTRUE_SMTP_SENDER_NAME=
GOTRUE_SMTP_TLS=
GOTRUE_MAILER_EXTERNAL_HOSTS=

# SEC-003 request-bound identities. Never put private PEM values in shared env.
# Compose mounts individual keys; host services use their own file paths.
XYNES_INTERNAL_IDENTITIES_DIR=./.internal-identities
GATEWAY_INTERNAL_REQUEST_KEY_ID=g1
ACCOUNTS_INTERNAL_REQUEST_KEY_ID=a1
# INTERNAL_REQUEST_PRIVATE_KEY_FILE and INTERNAL_REQUEST_KEY_ID are service-specific.
# Accounts/authz: INTERNAL_REQUEST_TRUST_FILE points to a public trust JSON file.
# See infra/release/INTERNAL-REQUEST-IDENTITIES.md for provisioning/rotation.
