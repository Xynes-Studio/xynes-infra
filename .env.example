# =============================================================================
# xynes-infra — example env for the Docker dev stack
# =============================================================================
#
# Copy this file to one of:
#   .env.dev          — Docker dev stack against hosted/tunneled Supabase
#   .env.dev.local    — Docker dev stack with local Supabase (recommended)
#
# Both files are git-ignored (see .gitignore: `.env.*` excluded with
# `!.env.example` exception).
#
# Generate per-line secrets locally — never paste secrets into chat, PR
# comments, or upstream documentation. See:
#   - ENV_GUIDE.md
#   - docs/plans/2026-05-13-storage-provider-env-values-worksheet.md
# =============================================================================


# -----------------------------------------------------------------------------
# Shared dev ports (host side)
# -----------------------------------------------------------------------------
GATEWAY_PORT=4100
DOC_SERVICE_PORT=4101
CMS_CORE_PORT=4102
ACCOUNTS_SERVICE_PORT=4103
AUTHZ_SERVICE_PORT=4104
TELEMETRY_SERVICE_PORT=4105
# STORAGE-12: storage-service port. Matches storage-service `src/infra/config.ts`
# DEFAULT_PORT (4204) and the compose container's STORAGE_SERVICE_PORT.
STORAGE_SERVICE_PORT=4204


# -----------------------------------------------------------------------------
# Internal URLs (what the gateway uses inside the docker network)
# -----------------------------------------------------------------------------
DOC_SERVICE_URL=http://doc-service:4101
CMS_CORE_URL=http://cms-core:4102
ACCOUNTS_SERVICE_URL=http://accounts-service:4103
AUTHZ_SERVICE_URL=http://authz-service:4104
TELEMETRY_SERVICE_URL=http://telemetry-service:4105

# STORAGE-12: Universal Object Storage service URL. Gateway proxies
# /workspaces/:workspaceId/storage/* routes to this base URL appended
# with /internal/storage-actions. When unset, storage routes fail
# closed at the gateway with 502 BAD_GATEWAY.
STORAGE_SERVICE_URL=http://storage-service:4204


# -----------------------------------------------------------------------------
# Shared internal auth (service-to-service)
# -----------------------------------------------------------------------------

# Legacy shared bearer token between gateway and downstream services.
# Generate with: `openssl rand -hex 32`
INTERNAL_SERVICE_TOKEN=replace-with-openssl-rand-hex-32

# SEC-INTERNAL-AUTH-2: Internal JWT signing key for secure service-to-service auth.
# Used to sign JWTs with audience (target service) and expiration.
# Generate with: `openssl rand -hex 32`
INTERNAL_JWT_SIGNING_KEY=replace-with-openssl-rand-hex-32

# Feature flag for transitional period.
# Set to `jwt` to disable legacy shared-token support.
INTERNAL_AUTH_MODE=jwt

# TELE-GW-1: Salt for hashing client IPs in gateway telemetry (privacy protection).
# Generate with: `openssl rand -hex 32`
TELEMETRY_IP_HASH_SALT=replace-with-openssl-rand-hex-32


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# `db.local` is pinned via docker-compose `extra_hosts` to the IPv4 host-gateway
# so containers can reliably reach your SSH tunnel / local Supabase. See
# ENV_GUIDE.md for the recommended values per env mode.
DATABASE_URL=postgres://postgres:postgres@db.local:5432/postgres
ANON_KEY=replace-with-supabase-anon-key

# Accounts service uses a dedicated DB user when available; otherwise point at
# DATABASE_URL.
ACCOUNTS_DATABASE_URL=postgres://postgres:postgres@db.local:5432/postgres


# -----------------------------------------------------------------------------
# Feature flags (INFRA-BE-1)
# -----------------------------------------------------------------------------
POSTHOG_API_KEY=replace-with-posthog-project-api-key
POSTHOG_HOST=https://app.posthog.com


# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# JWT secret used by both the gateway and Supabase Auth in local mode.
# For local Supabase, this MUST match the secret in supabase/config.toml,
# otherwise /me returns 401. See ENV_GUIDE.md.
JWT_SECRET=replace-with-local-supabase-jwt-secret


# =============================================================================
# Universal Object Storage — STORAGE-4 (capture during provisioning)
# =============================================================================
#
# These env values feed `platform.workspace_storage_providers` rows when a
# workspace is provisioned. The schema is the same for every S3-compatible
# provider — only the values differ. See:
#   - docs/plans/2026-05-10-universal-object-storage-file-upload-api.md §3
#   - docs/plans/2026-05-13-storage-provider-env-values-worksheet.md
#
# Security rules:
#   - Never commit a populated copy of this file (`.env.*` is git-ignored).
#   - Raw access keys and secret keys go ONLY in a git-ignored `.env.dev.local`
#     for local-dev runs. Production / hosted environments wire a real
#     `SecretManagerClient` (AWS Secrets Manager / Doppler / Vault) — the
#     `EnvSecretManagerClient` path is local-dev only.
#   - The storage-service resolves credentials at runtime via the
#     `credential_ref` column on `platform.workspace_storage_providers`.
#     The env-var naming convention below MUST match
#     `xynes-storage-service/src/infra/providers/secret-manager.ts`
#     `secretPathToEnvPrefix(path)` so the resolver can find the values:
#       `secret://xynes/storage/r2-dev` →
#         `STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_ACCESS_KEY_ID`
#         `STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_SECRET_ACCESS_KEY`
#   - Never paste raw keys into chat, PR comments, or commit history. If a key
#     ever appears in any of those, rotate it at the provider immediately.
# =============================================================================


# -----------------------------------------------------------------------------
# Cloudflare R2 — default hosted provider for STORAGE-4 / STORAGE-LIVE-1
# -----------------------------------------------------------------------------
# Provision steps:
#   1. Cloudflare dashboard → R2 → Overview → copy Account ID (32 hex chars).
#   2. R2 → Create bucket → name = R2_BUCKET below.
#   3. R2 → Manage API tokens → Create API token → "Object Read & Write" →
#      scope to the bucket → copy access key id + secret access key ONCE.
#   4. Paste the raw key + secret into your git-ignored `.env.dev.local`
#      under the STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_* names below.
#      Do NOT paste them into THIS .env.example file (it is committed).
# -----------------------------------------------------------------------------

# 32-char hex Cloudflare Account ID.
R2_ACCOUNT_ID=00000000000000000000000000000000

# Bucket name. Suggested convention: xynes-storage-<env>.
R2_BUCKET=xynes-storage-dev

# R2 region MUST be `auto`. Empty string and `us-east-1` also alias to `auto`.
R2_REGION=auto

# Derived endpoint host — uncomment after R2_ACCOUNT_ID is filled in.
# R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# Optional storage class. R2 supports `STANDARD` and `STANDARD_IA`.
R2_STORAGE_CLASS=STANDARD

# Token credentials — STORAGE-FU-3 EnvSecretManagerClient convention.
# Read by `xynes-storage-service` when a `platform.workspace_storage_providers`
# row points at `credential_ref = 'secret://xynes/storage/r2-dev'`.
# Fill the real values ONLY in a git-ignored `.env.dev.local`; this template
# uses placeholder strings the resolver will reject as MATERIAL_INVALID.
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_ACCESS_KEY_ID=replace-with-cloudflare-r2-access-key-id
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_SECRET_ACCESS_KEY=replace-with-cloudflare-r2-secret-access-key


# -----------------------------------------------------------------------------
# Backblaze B2 — alternate hosted provider (deferred to STORAGE-LIVE-6)
# -----------------------------------------------------------------------------
# Provision steps:
#   1. Backblaze console → Buckets → Create a Bucket → Private →
#      name = B2_BUCKET below (no underscores; `b2-` prefix reserved).
#   2. App Keys → Add a New Application Key → scope to the bucket →
#      permissions `readWrite + listBuckets + listFiles` → copy ID + key ONCE.
# B2-specific quirks (already baked into STORAGE-4 / 9):
#   - SigV4 only (v2 rejected).
#   - `x-amz-tagging` on PUT/Copy is rejected.
#   - No browser POST form uploads.
#   - CORS XML ≤ 100 KB, MaxAgeSeconds ∈ [0, 86400], non-empty AllowedOrigin.
# -----------------------------------------------------------------------------

# Real region — NOT `auto`. Example: us-east-005, eu-central-003.
B2_REGION=us-east-005

# Bucket name. Suggested convention: xynes-storage-<env>-b2.
B2_BUCKET=xynes-storage-dev-b2

# Derived endpoint host — uncomment after B2_REGION is filled in.
# B2_ENDPOINT=https://s3.${B2_REGION}.backblazeb2.com

# Application Key credentials — STORAGE-FU-3 convention.
# Read by `xynes-storage-service` when `credential_ref = 'secret://xynes/storage/b2-dev'`.
STORAGE_CREDENTIAL_XYNES__STORAGE__B2_DEV_ACCESS_KEY_ID=replace-with-backblaze-b2-application-key-id
STORAGE_CREDENTIAL_XYNES__STORAGE__B2_DEV_SECRET_ACCESS_KEY=replace-with-backblaze-b2-application-key


# -----------------------------------------------------------------------------
# iDrive e2 — alternate hosted provider (deferred indefinitely)
# -----------------------------------------------------------------------------
# Capture only when a workspace adopts e2. Onboarding gate: a region MUST be
# enabled via Dashboard → Regions dropdown → "Enable" BEFORE the "Create Bucket"
# CTA appears in the e2 console. See the worksheet for full provisioning steps.
# -----------------------------------------------------------------------------

# Real region — NOT `auto`. e.g. Frankfurt, Singapore.
# E2_REGION=

# Per-account, per-region endpoint host shown under Dashboard → Enabled regions
# after the region has been enabled. NOT derivable from E2_REGION alone.
# E2_ENDPOINT=

# Bucket name. Suggested convention: xynes-storage-<env>-e2.
# E2_BUCKET=xynes-storage-dev-e2

# Access key credentials (shown once at creation in the e2 Access Keys tab).
# E2_ACCESS_KEY_ID=
# E2_SECRET_ACCESS_KEY=
