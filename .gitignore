# Secrets
.env
.env.*
!.env.example
# Committed placeholder templates for VPS env files (see infra/release/templates/).
# Real values NEVER live in these files; static gate at
# scripts/test/env-templates-no-secrets.test.sh sweeps them on every CI run.
!.env.*.template

# OS
.DS_Store

