.tmp/
*.bak

# SEC-003 generated service identities
.internal-identities/

# Generated/private operational material; public infra commits source and pins only.
node_modules/
.apex-private/
*.oci.tar
*.pgdump
*.dump
*.sql.gz
*.tar.gz
*.zip
*.key
*.pem
*.age
*.log

# Generated Python interpreter caches
__pycache__/
*.py[cod]
